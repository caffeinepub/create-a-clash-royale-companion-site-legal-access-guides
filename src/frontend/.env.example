# Public site URL for canonical and social metadata (OPTIONAL)
# 
# When NOT set: The app will automatically use the current browser address
# (e.g., "clashroyalegooner-rwo.caffeine.xyz") for canonical URLs and social metadata.
#
# When set: The app will use this value instead of the detected browser address.
# This is useful if you have a custom domain or want to override the default.
#
# Examples:
#   VITE_PUBLIC_SITE_URL=clashroyalehub.com
#   VITE_PUBLIC_SITE_URL=my-custom-domain.com
#
# Note: This only affects metadata (SEO, social sharing). It does NOT change
# the actual browser address bar URL, which is controlled by deployment settings.
VITE_PUBLIC_SITE_URL=
